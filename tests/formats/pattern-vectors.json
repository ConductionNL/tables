{
	"portable": [
		"^[0-9]{4} ?[A-Z]{2}$",
		"^(?!00)[0-9]{5}$",
		"^(\\+31|0031|0)[1-9][0-9]{8}$",
		"^(?<year>[0-9]{4})-\\k<year>$",
		"^(?:a|b)+?c*?d??$",
		"(?<=@)example\\.org$",
		"(?<!x)y",
		"^[\\w.+-]+@[\\w-]+\\.[\\w.-]+$",
		"^[{}()|]$",
		"^\\p{L}+$",
		"^é😀\\x41$",
		"^\\cJ\\0$",
		"\\bword\\B",
		"^[\\b\\-\\]]$",
		"^\\/\\{\\}\\[\\]$",
		"^(a)\\1$",
		"^.{2,}$"
	],
	"refused": [
		{"pattern": "^a++$", "uses": "possessive quantifiers"},
		{"pattern": "^a{2}+$", "uses": "possessive quantifiers"},
		{"pattern": "^(?>ab|a)c$", "uses": "atomic groups"},
		{"pattern": "\\Aabc\\z", "uses": "the escape \\A"},
		{"pattern": "abc\\Z", "uses": "the escape \\Z"},
		{"pattern": "^(?P<year>[0-9]{4})$", "uses": "Python-style named groups"},
		{"pattern": "^(?'year'[0-9]{4})$", "uses": "named groups in quotes"},
		{"pattern": "^[[:alpha:]]+$", "uses": "POSIX character classes"},
		{"pattern": "(?i)abc", "uses": "inline flags"},
		{"pattern": "(?i:abc)", "uses": "inline flags"},
		{"pattern": "^\\x{41}$", "uses": "\\x{…}"},
		{"pattern": "^\\u00e9$", "uses": "\\u, which only JavaScript knows"},
		{"pattern": "(*UCP)\\d", "uses": "verbs"},
		{"pattern": "^\\pL$", "uses": "\\p without {…}"},
		{"pattern": "^\\v$", "uses": "the escape \\v"},
		{"pattern": "^\\h+$", "uses": "the escape \\h"},
		{"pattern": "^\\Qa.b\\E$", "uses": "the escape \\Q"},
		{"pattern": "^a{,3}$", "uses": "a { that does not start a quantifier"},
		{"pattern": "^a}$", "uses": "an unescaped }"},
		{"pattern": "^a]$", "uses": "an unescaped ]"},
		{"pattern": "^[]a]$", "uses": "an empty character class"},
		{"pattern": "^\\-$", "uses": "the escape \\-"},
		{"pattern": "(?#comment)a", "uses": "comments"},
		{"pattern": "(?|(a)|(b))", "uses": "branch reset groups"},
		{"pattern": "(a)(?(1)b|c)", "uses": "conditional groups"},
		{"pattern": "(a(?R)?b)", "uses": "recursion"},
		{"pattern": "abc\\", "uses": "a \\ at the end"},
		{"pattern": "[abc", "uses": "a character class that is not closed"}
	]
}
